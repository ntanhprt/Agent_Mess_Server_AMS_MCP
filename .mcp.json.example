{
  "mcpServers": {
    "agent-mesh": {
      "command": "/absolute/path/to/.venv/bin/agent-mesh-mcp",
      "env": {
        "AGENT_GATEWAY_URL": "http://localhost:10420",
        "AGENT_MESH_JOIN_TOKEN": "<the-join-token>",
        "AGENT_MESH_MINIO_ENDPOINT": "https://s3.aisolutions.vn",
        "AGENT_MESH_MINIO_ACCESS_KEY": "agentmesh",
        "AGENT_MESH_MINIO_SECRET_KEY": "<the-minio-secret-key>"
      }
    }
  }
}
